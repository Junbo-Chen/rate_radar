# Het interne endpoint uit Eric's Laravel-app (routes/api.php).
# Kopieer dit bestand naar .env en pas de URL aan zodra de back-end draait.
VITE_API_URL=http://localhost:8000/api/rate-limits

# CRUD-endpoint voor de API-credentials (store id, key, secret).
VITE_CREDENTIALS_URL=http://localhost:8000/api/credentials
