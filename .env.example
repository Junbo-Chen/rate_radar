# Eric's Laravel-endpoint met de actuele rate limits.
# Let op: dit geeft één momentopname terug, geen geschiedenis — de frontend
# stapelt de metingen zelf op zolang de pagina open staat.
VITE_API_URL=http://localhost:8000/api/account/ratelimit

# CRUD-endpoint voor de API-credentials (store id, key, secret).
# Nog niet in gebruik: de back-end heeft geen routes naar
# ApiCredentialsController, dus die draait nog op de lokale driver.
VITE_CREDENTIALS_URL=http://localhost:8000/api/credentials

# De Laravel-server zelf. Inloggen en registreren lopen via Fortify-routes op de
# root (/login, /register), dus niet onder /api.
VITE_BACKEND_URL=http://localhost:8000
